# Trình duyệt gọi API qua đường dẫn tương đối /api — Next tự chuyển sang
# backend (next.config.ts). Bắt buộc để link chia sẻ (VS Code Ports/ngrok/
# IP LAN) dùng được: "http://localhost:3001" sẽ trỏ vào máy của người xem.
NEXT_PUBLIC_API_URL=/api

# Server Next (Server Component + proxy /api) gọi thẳng backend trên máy này.
API_URL=http://localhost:3001
